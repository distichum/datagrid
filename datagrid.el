;;;; Helper functions:
(defun datagrid-safe-transpose (seq-of-seqs)
  "Transpose a sequence of sequences and pad short rows if needed.
SEQ-OF-SEQS is a sequence of sequences. The result is a list of lists.
Return nil when SEQ-OF-SEQS is empty."
  (unless (seq-empty-p seq-of-seqs)
    (let ((max-cols (apply #'max (mapcar #'length seq-of-seqs))))
      (apply #'cl-mapcar #'list
             (cl-loop for row being the elements of seq-of-seqs
                      ;; `append' turns a vector ROW into list elements.
                      collect (append row (make-list (- max-cols (length row))
                                                     nil)))))))

(defun datagrid-unknown-type-to-number (seq)
  "Convert a sequence of unknown types to numbers.
Convert a SEQ of unknown data types to a sequence of
numbers. Leave nil values in place."
  (let ((seqnow (seq-into seq 'list)))
    (vconcat
     (cl-loop for item in seqnow
              collect (cond ((stringp item) (if (equal item "")
                                                nil
                                              (string-to-number item)))
                            ((numberp item) item)
                            ((null item) item)
                            (t (error "%S cannot be coerced into a number"
                                      item)))))))

(defun datagrid--empty-p (v)
  "Return non-nil if V should be treated as missing.
Nil and empty strings are considered empty."
  (or (null v) (and (stringp v) (string-empty-p v))))

(defun datagrid--build-index (vec)
  "Return hashtable mapping VEC values to first-occurrence index.
Empty values (per `datagrid--empty-p') and later duplicates are skipped."
  (let ((ht (make-hash-table :test #'equal))
        (i 0)
        (n (length vec)))
    (while (< i n)
      (let ((v (aref vec i)))
        (unless (or (datagrid--empty-p v) (gethash v ht))
          (puthash v i ht)))
      (setq i (1+ i)))
    ht))

(defun datagrid--resolve-on (on dg1 dg2)
  "Resolve the :on argument ON into a cons (IDX1 . IDX2).
ON is an integer index or a heading string that names a column in
both DG1 and DG2, or a cons (A . B) where A names a column in DG1 and
B a column in DG2. IDX1 and IDX2 are logical column indices. Signal
an error if ON is nil or malformed, and signal `wrong-type-argument'
unless DG1 and DG2 are datagrids. The joins and `datagrid-rows-patch'
share this, so it lives here rather than in either file."
  (unless on (error ":on is required"))
  (datagrid--check dg1)
  (datagrid--check dg2)
  (pcase on
    ((or (pred integerp) (pred stringp))
     (cons (datagrid--resolve-col dg1 on)
           (datagrid--resolve-col dg2 on)))
    (`(,a . ,b)
     (cons (datagrid--resolve-col dg1 a)
           (datagrid--resolve-col dg2 b)))
    (_ (error "Bad :on value: %S" on))))

(defun datagrid-unknown-type-sort (a b)
  "Predicate sort function when type is unknown.
A and B must be the same type but the type may not be known ahead of
time."
  (cond
   ((numberp a) (< a b))
   ((stringp a) (string< a b))
   ((symbolp a) (string< (symbol-name a) (symbol-name b)))
   ;; Use string comparison if others don't match.
   (t (string< (format "%s" a) (format "%s" b)))))


;;;; datagrid-column functions
(defun datagrid-column-p (dg-c)
  "Return non-nil if DG-C is a datagrid-column, nil otherwise.
Headings must be strings. Data must be a vector. LOM must be a string.
Code must be an alist."
  (and (datagrid--column-type-p dg-c)
       (or (null (datagrid-column-heading dg-c))
           (stringp (datagrid-column-heading dg-c)))
       (or (null (datagrid-column-data dg-c))
           (vectorp (datagrid-column-data dg-c)))
       (or (null (datagrid-column-lom dg-c))
           (stringp (datagrid-column-lom dg-c)))
       (or (null (datagrid-column-code dg-c))
           (listp (datagrid-column-code dg-c)))))

(defun datagrid-column-set-length (dg-c n)
  "Truncate or expand the data in a datagrid column.
Data may be truncated, extended with nils, or left the same. DG-C is the
datagrid column. N is the length.

This creates a new vector and replaces the old. Signal an error
unless DG-C satisfies `datagrid-column-p'."
  (datagrid--check-column dg-c)
  (let* ((vec (or (datagrid-column-data dg-c) []))
         (len (length vec)))
    (if (= len n)
        dg-c
      (let ((new (datagrid-column-copy dg-c)))
        (setf (datagrid-column-data new)
              (if (< n len)
                  (seq-take vec n)
                (seq-concatenate 'vector vec (make-vector (- n len) nil))))
        new))))

(defun datagrid--column-add-data (dg-c seq)
  "Add one or more elements to a datagrid column's data.
DG-C is the datagrid column. SEQ is a sequence. The result of this
function is a datagrid-column.

WARNING: the result is longer than the other columns of its
datagrid, so the caller must keep the column lengths in sync.
Signal an error unless DG-C satisfies `datagrid-column-p'."
  (datagrid--check-column dg-c)
  (let ((new (datagrid-column-copy dg-c)))
    (setf (datagrid-column-data new)
          (vconcat (datagrid-column-data dg-c) seq))
    new))


;;;; Create datagrid-column methods for seq
;; These methods only return things in the :data slot. streams.el and
;; ordered-set.el are good examples of extending seq functions.

(cl-defmethod seq-elt ((datagrid-column datagrid-column) n)
  "Return the Nth element of the DATAGRID-COLUMN data."
  (elt (datagrid-column-data datagrid-column) n))

(cl-defmethod seq-length ((datagrid-column datagrid-column))
  "Return the length of the DATAGRID-COLUMN data."
  (length (datagrid-column-data datagrid-column)))

(cl-defmethod seq-do (function (datagrid-column datagrid-column))
  "Apply FUNCTION to each element of DATAGRID-COLUMN data.
Return the original DATAGRID-COLUMN. Presumably, FUNCTION has
useful side effects."
  (mapc function (datagrid-column-data datagrid-column))
  datagrid-column)

(cl-defmethod seqp ((_datagrid-column datagrid-column))
  "DATAGRID-COLUMN is a sequence or sequences."
  t)

(cl-defmethod seq-subseq ((datagrid-column datagrid-column) start &optional end)
  "Return a new DATAGRID-COLUMN containing a range of elements.
START is the first element to select and END is the last. END is
exclusive. If END is omitted, it defaults to the length of the
data. Negative START or END counts from the end, as in `seq-subseq'."
  (let ((new (datagrid-column-copy datagrid-column)))
    (setf (datagrid-column-data new)
          (seq-subseq (datagrid-column-data datagrid-column) start end))
    new))

(cl-defmethod seq-into-sequence ((datagrid-column datagrid-column))
  "Return DATAGRID-COLUMN as a sequence."
  ;; Since a datagrid-column is a record data type, this does nothing
  ;; but expose the sequence part of datagrid-column.
  (datagrid-column-data datagrid-column))

(cl-defmethod seq-copy ((datagrid-column datagrid-column))
  "Return a shallow copy of DATAGRID-COLUMN."
  (datagrid-column-copy datagrid-column))

(cl-defmethod seq-into ((datagrid-column datagrid-column) type)
  "Convert DATAGRID-COLUMN into a sequence of type TYPE.
This is lossy because other DATAGRID-COLUMN slots are not copied."
  (seq-into (seq-into-sequence datagrid-column) type))

(cl-defmethod seq-into (sequence (_type (eql datagrid-column)))
  "Convert SEQUENCE into a DATAGRID-COLUMN."
  (datagrid-column-make :data (seq-into sequence 'vector)))



;;;; Making and changing data grids
(defun datagrid-from-alist (alist &optional headings extend-uneven)
  "Create a datagrid from ALIST, a list with one list per column.
If HEADINGS is non-nil, the first element of each list is the column
heading and the rest is the data. If HEADINGS is nil, every element is
data and the columns have no headings.

Signal an error if the columns have different lengths, unless
EXTEND-UNEVEN is non-nil. Then shorter columns are padded with nil to
the length of the longest. An empty ALIST gives a datagrid with no
columns."
  (let* ((labels (cl-loop for item in alist
                          collect (and headings (car item))))
         (values (mapcar (if headings #'cdr #'identity) alist))
         (lengths (mapcar #'length values))
         (len (apply #'max 0 lengths)))
    (unless (or extend-uneven (cl-every (lambda (n) (= n len)) lengths))
      (error "Columns have unequal lengths %S. Pass EXTEND-UNEVEN to pad them with nil"
             (if headings (cl-mapcar #'cons labels lengths) lengths)))
    (datagrid-make
     :columns
     (vconcat (cl-loop for label in labels
                       for data in values
                       for pad = (make-list (- len (length data)) nil)
                       collect (datagrid-column-make
                                :heading label
                                :data (vconcat data pad)))))))

(defun datagrid-make-empty (col-num row-num &optional init heading-list)
  "Create a new datagrid with specified dimensions.
COL-NUM is the number of columns. ROW-NUM is the number of rows in
each column. HEADING-LIST is a list whose length must equal the
number of columns. INIT is the value of each element in each :data
slot vector in each datagrid-column struct."
  (datagrid-make
   :columns
   (vconcat (cl-loop for j below col-num
                     collect (datagrid-column-make
                              :heading (nth j heading-list)
                              :data (make-vector row-num init))))))


(defun datagrid-from-vectors (&rest vectors)
  "Create a datagrid from VECTORS, one vector per column.
The first element of each vector is the column heading and the rest
is the data.

Signal an error if the columns have different lengths. To pad shorter
columns with nil instead, as EXTEND-UNEVEN does in
`datagrid-from-alist', put :extend-uneven and a non-nil value before
the vectors.

Examples:

  (datagrid-from-vectors [\"a\" 1 2] [\"b\" 3 4])
  (datagrid-from-vectors :extend-uneven t [\"a\" 1 2] [\"b\" 3])"
  (let ((extend-uneven nil))
    (when (eq (car vectors) :extend-uneven)
      (setq extend-uneven (cadr vectors)
            vectors (cddr vectors)))
    (unless (and vectors
                 (cl-every (lambda (v) (and (vectorp v) (> (length v) 0)))
                           vectors))
      (error "Each argument must be a vector that starts with a heading"))
    (datagrid-from-alist (cl-loop for v in vectors
                                  collect (append v nil))
                         t extend-uneven)))

(defun datagrid--from-csv-rows (rows headings)
  "Return a datagrid from ROWS, a list of parsed CSV rows.
HEADINGS is as in `datagrid-from-csv-file'. The first row sets the
number of fields. A row with fewer fields is padded with nil. Signal
an error for a row with more fields, naming the row."
  (let ((width (length (car rows)))
        (n 0))
    (dolist (row rows)
      (setq n (1+ n))
      (when (> (length row) width)
        (error "CSV row %d has %d fields, but the first row has %d"
               n (length row) width)))
    (datagrid-from-alist (datagrid-safe-transpose rows) headings)))

(defun datagrid-from-csv-buffer (buffer-or-name &optional headings)
  "Return a datagrid from an open csv buffer.
BUFFER-OR-NAME is the buffer name. If HEADINGS is nil, then there
is not a headings row. If t, then there is. The default is nil.

The first row sets the number of fields. A row with fewer fields is
padded with nil. A row with more fields signals an error that names
the row.

This requires the csv-mode package."
  (require 'csv-mode)
  (with-current-buffer buffer-or-name
    (save-excursion
      (let ((rows nil))
        (goto-char (point-min))
        (while (not (eobp))
          (push (csv-parse-current-row) rows)
          (forward-line))
        (datagrid--from-csv-rows (nreverse rows) headings)))))

(defun datagrid-from-csv-file (file-path &optional headings parser
                                         _extend-uneven)
  "Return a datagrid from a CSV file at FILE-PATH.
If HEADINGS is nil, then there is not a headings row. If t, then
there is. The default is nil.

PARSER selects the CSV backend:
  nil or `csv-mode' (default) - use `csv-mode' line-by-line.
  `pcsv'                      - use pcsv's streaming `pcsv-file-parser',
                                which handles multiline quoted fields and
                                very large files without regex-stack
                                overflow. Requires the pcsv package.

The first row sets the number of fields. A row with fewer fields is
padded with nil. A row with more fields signals an error that names
the row.

The fourth argument, EXTEND-UNEVEN, is obsolete since 1.1 and is
ignored. It never had an effect, because short rows were always
padded."
  (declare (advertised-calling-convention
            (file-path &optional headings parser) "1.1"))
  (pcase (or parser 'csv-mode)
    ('csv-mode
     (require 'csv-mode)
     (with-temp-buffer
       (insert-file-contents file-path)
       (goto-char (point-min))
       (while (search-forward "\r" nil t)
         (replace-match "" nil t))
       (csv-mode)
       (datagrid-from-csv-buffer (current-buffer) headings)))
    ('pcsv
     (require 'pcsv)
     (let ((reader (pcsv-file-parser file-path)))
       (unwind-protect
           (datagrid--from-csv-rows (cl-loop for row = (funcall reader)
                                             while row
                                             collect row)
                                    headings)
         (funcall reader t))))
    (_ (error "Unknown CSV parser: %S" parser))))

(defun datagrid--csv-quote-field (field)
  "Return FIELD as a CSV-safe string.
Quote and escape if FIELD contains a comma, double quote, or newline.
Nil becomes an empty field."
  (cond
   ((null field) "")
   (t (let ((s (if (stringp field) field (format "%s" field))))
        (if (string-match-p "[\",\n\r]" s)
            (concat "\"" (replace-regexp-in-string "\"" "\"\"" s) "\"")
          s)))))

(defun datagrid--insert-csv (datagrid &optional headings)
  "Insert DATAGRID at point in the current buffer as CSV.
If HEADINGS is non-nil, insert a heading row first. Iterates DATAGRID
in logical row and column order. This is lossy: the LOM and CODE slots
are not preserved."
  (datagrid--check datagrid)
  (let* ((cols (datagrid-columns datagrid))
         (ncols (datagrid--ncols datagrid))
         (nrows (datagrid--nrows datagrid)))
    (when headings
      (insert (mapconcat #'datagrid--csv-quote-field
                         (append (datagrid-get-headings datagrid) nil)
                         ","))
      (insert "\n"))
    (dotimes (i nrows)
      (let ((phys-row (datagrid--row-at datagrid i)))
        ;; string-join is fastest method I found.
        (insert (string-join
                 (cl-loop for j below ncols
                          for col = (aref cols (datagrid--col-at datagrid j))
                          collect (datagrid--csv-quote-field
                                   (aref (datagrid-column-data col) phys-row)))
                 ","))
        (insert "\n")))))

(defun datagrid-to-csv-file (datagrid file-path &optional headings)
  "Write DATAGRID to FILE-PATH as CSV.
If HEADINGS is non-nil, write a heading row first. This is lossy:
the LOM and CODE slots are not preserved."
  (with-temp-file file-path
    (datagrid--insert-csv datagrid headings)))

(define-obsolete-function-alias 'datagrid-write-csv
  #'datagrid-to-csv-file "1.1")

(defun datagrid-to-csv-buffer (datagrid buffer-name &optional headings)
  "Insert DATAGRID as CSV into a new buffer named BUFFER-NAME and display it.
A fresh buffer is generated (the name is uniquified if needed). If
HEADINGS is non-nil, insert a heading row first. Return the new
buffer. This is lossy: the LOM and CODE slots are not preserved."
  (let ((buf (generate-new-buffer buffer-name)))
    (with-current-buffer buf
      (datagrid--insert-csv datagrid headings)
      (goto-char (point-min)))
    (pop-to-buffer buf)
    buf))

(define-obsolete-function-alias 'datagrid-to-csvbuf
  #'datagrid-to-csv-buffer "1.1")

(defun datagrid-to-vec-of-vec (datagrid)
  "Create a vector of vectors from DATAGRID in logical order.
This is a lossy function because it does not maintain the headings,
code, or lom slot."
  (let ((ncols (datagrid--ncols datagrid)))
    (vconcat (cl-loop for j from 0 below ncols
                      collect (datagrid-pull datagrid j)))))

(defun datagrid-to-alist (datagrid &optional headings)
  "Create an alist from a DATAGRID.
If HEADINGS is non-nil, return headings as the first item in each
list. Otherwise return only data."
  (let ((hdngs (and headings
                    (append (datagrid-get-headings datagrid) nil)))
        (data (datagrid-to-vec-of-vec datagrid)))
    (cl-loop for x from 0 below (length data)
             collect (if hdngs
                         (append (list (elt hdngs x))
                                 (append (elt data x) nil))
                       (append (elt data x) nil)))))

(defun datagrid-to-vtable (datagrid buffer-name &optional headings)
  "Create a vtable from a DATAGRID.
If HEADINGS is non-nil, create a vtable with a headings row.
BUFFER-NAME is the name of buffer where Emacs will create the
vtable. This requires the vtable library from Emacs 29.1 or later."
  (unless (require 'vtable nil t)
    (user-error "Creating a vtable requires Emacs 29.1 or later"))
  (let ((hdngs (and headings
                    (append (datagrid-get-headings datagrid) nil)))
        (data (datagrid-safe-transpose (datagrid-to-alist datagrid))))
    (get-buffer-create buffer-name)
    (with-current-buffer buffer-name
      (erase-buffer)
      (make-vtable
       :columns hdngs
       :objects data)
      (goto-char (point-min))
      (pop-to-buffer buffer-name))))

(defun datagrid--org-cell (value digits)
  "Return VALUE prepared for an Org table cell.
Nil becomes an empty string. When DIGITS is non-nil, a finite float
is rounded to DIGITS decimal places. A vertical bar in a string would
split the cell, so it is replaced by the Org entity \\vert{}. Other
values are returned unchanged."
  (cond ((null value) "")
        ((and digits (floatp value) (< (abs value) 1.0e+INF))
         (string-to-number (format (format "%%.%df" digits) value)))
        ((stringp value) (string-replace "|" "\\vert{}" value))
        (t value)))

(defun datagrid--org-format-number (value fmt)
  "Return VALUE written with FMT when VALUE is a number.
FMT is a format string, a function of one argument, or nil. VALUE is
returned unchanged when it is not a number or FMT is nil."
  (cond ((not (and fmt (numberp value))) value)
        ((stringp fmt) (format fmt value))
        (t (funcall fmt value))))

(defun datagrid--org-formats (datagrid fmt)
  "Return a list with the number format for each column of DATAGRID.
FMT is the FORMAT argument of `datagrid-to-org-table'. The list has
one element per logical column, in logical order. An element is nil
for a column whose numbers are left as they are. Signal an error for
a malformed FMT, a column listed more than once, or a column that is
not in DATAGRID."
  (let ((ncols (datagrid--ncols datagrid)))
    (cond
     ((null fmt) (make-list ncols nil))
     ((or (stringp fmt) (functionp fmt)) (make-list ncols fmt))
     ((consp fmt)
      (let ((fmts (make-vector ncols nil)))
        (dolist (entry fmt)
          (let ((cols (car-safe entry))
                (f (cdr-safe entry)))
            (unless (and (consp entry) (or (stringp f) (functionp f)))
              (error "Bad :format entry: %S" entry))
            (dolist (c (ensure-list cols))
              (let ((j (datagrid--resolve-col datagrid c)))
                (unless (and (>= j 0) (< j ncols))
                  (error "Column index out of range: %S" c))
                (when (aref fmts j)
                  (error "Column listed more than once: %S" c))
                (aset fmts j f)))))
        (append fmts nil)))
     (t (error "Bad :format value: %S" fmt)))))

(defun datagrid--reduce-non-nil (fn vec)
  "Return FN reduced over the non-nil values of VEC.
With no non-nil values, return (funcall FN) when FN accepts zero
arguments, and nil otherwise, as `datagrid-reduce-vec' does."
  (let ((vals (cl-loop for v across vec when v collect v)))
    (cond (vals (cl-reduce fn vals))
          ((zerop (car (func-arity fn))) (funcall fn))
          (t nil))))

(defun datagrid--org-footer (datagrid footer)
  "Return the footer row of DATAGRID for FOOTER as a list of cells.
FOOTER is the FOOTER argument of `datagrid-to-org-table'. The list has
one value per logical column, in logical order, before formatting.
Signal an error for a malformed FOOTER."
  (let* ((spec (cond ((stringp footer) (list :label footer))
                     ((keywordp (car-safe footer)) footer)
                     (t (error "Bad :footer value: %S" footer))))
         (fn (or (plist-get spec :fn) #'+))
         (label (plist-get spec :label))
         (ncols (datagrid--ncols datagrid))
         (vecs (cl-loop for j from 0 below ncols
                        collect (datagrid-pull datagrid j)))
         (cols (if (plist-member spec :cols)
                   (cl-loop for c in (plist-get spec :cols)
                            for j = (datagrid--resolve-col datagrid c)
                            do (unless (and (>= j 0) (< j ncols))
                                 (error "Column index out of range: %S" c))
                            collect j)
                 (cl-loop for v in vecs
                          for j from 0
                          when (and (cl-some #'numberp v)
                                    (cl-every (lambda (x)
                                                (or (null x) (numberp x)))
                                              v))
                          collect j)))
         (label-col (and label
                         (or (cl-loop for j from 0 below ncols
                                      unless (memql j cols) return j)
                             (error "No column left for the footer label")))))
    (cl-loop for key in spec by #'cddr
             unless (memq key '(:label :fn :cols))
             do (error "Unknown :footer keyword %S" key))
    (unless (functionp fn)
      (error "Not a function: %S" fn))
    (cl-loop for v in vecs
             for j from 0
             collect (cond ((memql j cols) (datagrid--reduce-non-nil fn v))
                           ((eql j label-col) label)))))

(cl-defun datagrid-to-org-table (datagrid &key (headings t) (hline t)
                                          digits format footer)
  "Return DATAGRID as a list of rows for an Org table.
The result of an Org Mode code block that returns this list is
inserted as a table.

If HEADINGS is non-nil, the first row holds the column headings. The
default is t. If HLINE is non-nil, a horizontal rule follows the
headings row. The default is t. HLINE has no effect when HEADINGS is
nil. If DIGITS is non-nil, floats are rounded to DIGITS decimal
places. Integers are never changed.

FORMAT controls how numbers are written. It is a format string such
as \"%.2f\", or a function of one argument that returns the cell. It
applies to every number, integers included, and never to strings or
nil. FORMAT can also be an alist ((COLS . FMT) ...) that formats only
some columns. COLS is a column ref or a list of them, as in
`datagrid-column-coerce'. Signal an error if both DIGITS and FORMAT
are given.

FOOTER adds one row after the data rows, set off by a horizontal
rule. The row is computed here and is not added to DATAGRID. FOOTER
is a label string, or a plist (:label LABEL :fn FN :cols COLS). A
string is the same as (:label STRING).

For each column in COLS, the footer cell is FN reduced over that
column's values, as in `datagrid-reduce-vec'. Nil values are skipped.
FN defaults to `+'. COLS is a list of column refs. It defaults to
every column that holds at least one number and nothing but numbers
and nil. LABEL goes in the first column that is not in COLS. Other
footer cells are empty. Signal an error if LABEL is given and every
column is in COLS. FORMAT and DIGITS apply to footer cells as they do
to the data cells in the same column. HLINE does not affect the rule
above the footer.

Nil values become empty cells. Vertical bars in strings become the Org
entity \\vert{} so they do not split a cell. This includes strings
returned by a FORMAT function.

Examples:

  (datagrid-to-org-table dg)
  (datagrid-to-org-table dg :hline nil)
  (datagrid-to-org-table dg :headings nil :digits 2)
  (datagrid-to-org-table dg :format \"%.2f\")
  (datagrid-to-org-table dg :format \\='((\"n\" . \"%d\")
                                       ((\"cost\" \"price\") . \"%.2f\")))
  (datagrid-to-org-table dg :format \"%.2f\" :footer \"Total\")
  (datagrid-to-org-table dg :footer \\='(:label \"Top\" :fn max
                                       :cols (\"score\")))"
  (when (and digits format)
    (error "Give :digits or :format, not both"))
  (let* ((fmts (datagrid--org-formats datagrid format))
         (cell (lambda (v f)
                 (datagrid--org-cell (datagrid--org-format-number v f)
                                     digits)))
         (rows (cl-loop
                for row in (datagrid-safe-transpose
                            (datagrid-to-alist datagrid headings))
                for i from 0
                for heading-row = (and headings (= i 0))
                collect (cl-loop
                         for v in row
                         for f in fmts
                         collect (if heading-row
                                     (datagrid--org-cell v nil)
                                   (funcall cell v f)))))
         (rows (if (and headings hline rows)
                   (cons (car rows) (cons 'hline (cdr rows)))
                 rows)))
    (if (not footer)
        rows
      (append rows
              ;; Set the footer off, without doubling the headings rule.
              (and rows (not (eq (car (last rows)) 'hline))
                   (list 'hline))
              (list (cl-loop for v in (datagrid--org-footer datagrid footer)
                             for f in fmts
                             collect (funcall cell v f)))))))

(defun datagrid-column-add-code (datagrid cols code)
  "Add coding data to one or more `datagrid-columns'.
DATAGRID is a datagrid struct. COLS is a column ref (zero-based
integer or heading string) or a list of such refs. CODE is installed
in the CODE slot of each named column.

CODE is an alist where the keys are one possible interpretation
of the research data and the value is another. For example:

  ((\"Strongly disagree\" . 1)
   (\"Disagree\"          . 2)
   (\"Neutral\"           . 3)
   (\"Agree\"             . 4)
   (\"Strongly agree\"    . 5))"
  (datagrid--check datagrid)
  (let* ((targets (mapcar (lambda (c) (datagrid--resolve-col datagrid c))
                          (if (listp cols) cols (list cols))))
         (new-cols (copy-sequence (datagrid-columns datagrid))))
    (dolist (idx targets)
      (let* ((phys (datagrid--col-at datagrid idx))
             (new-col (datagrid-column-copy (aref new-cols phys))))
        (setf (datagrid-column-code new-col) code)
        (setf (aref new-cols phys) new-col)))
    (datagrid-make :columns new-cols
                   :row-order (datagrid-row-order datagrid)
                   :col-order (datagrid-col-order datagrid))))

(defun datagrid-column-coerce (datagrid converters)
  "Return a copy of DATAGRID with some columns converted value by value.
CONVERTERS is an alist of (COLS . FN). COLS is a column ref (zero-based
integer or heading string) or a list of such refs. FN is a function
of one argument that is called on every value in those columns, and
its result replaces the value. FN is a function, not a type name.

Converted columns keep their lom and code slots. The code alist is
not updated, so its keys may no longer match the converted data.
Signal an error if a column appears more than once in CONVERTERS.
DATAGRID is not modified.

For example, this reads a CSV file and converts two columns to
numbers:

  (datagrid-column-coerce
   (datagrid-from-csv-file \"data.csv\" t)
   \\='((\"age\" . string-to-number)
     ((\"q1\" \"q2\") . string-to-number)))"
  (datagrid--check datagrid)
  (let* ((ncols (datagrid--ncols datagrid))
         (fns (make-vector ncols nil)))
    (dolist (entry converters)
      (let ((fn (cdr entry)))
        (unless (functionp fn)
          (error "Not a function: %S" fn))
        (dolist (c (ensure-list (car entry)))
          (let ((j (datagrid--resolve-col datagrid c)))
            (unless (and (>= j 0) (< j ncols))
              (error "Column index out of range: %S" c))
            (when (aref fns j)
              (error "Column listed more than once: %S" c))
            (aset fns j fn)))))
    (datagrid-make
     :columns (datagrid--materialize-columns
               datagrid
               (lambda (j data)
                 (let ((fn (aref fns j)))
                   (if fn (cl-map 'vector fn data) data)))))))


;;;; Datagrid utilities; results are not datagrids
(defun datagrid-dimensions (datagrid)
  "Return the logical dimensions of DATAGRID as (columns . rows)."
  (cons (datagrid--ncols datagrid) (datagrid--nrows datagrid)))

(defun datagrid-get-elt (datagrid column-num row-num)
  "Get a value at a specific column and row.
COLUMN-NUM is a zero-based logical column index or a heading
string; ROW-NUM is a zero-based logical row index of DATAGRID.
This is the getter counterpart to `datagrid-set-elt'."
  (let* ((cols (datagrid-columns datagrid))
         (j (datagrid--col-at datagrid
                              (datagrid--resolve-col datagrid column-num)))
         (dg-col (aref cols j)))
    (aref (datagrid-column-data dg-col)
          (datagrid--row-at datagrid row-num))))

(defun datagrid-set-elt (datagrid column-num row-num value &optional inplace)
  "Return a datagrid with VALUE stored at COLUMN-NUM, ROW-NUM.
COLUMN-NUM is a zero-based logical column index or a heading string;
ROW-NUM is a zero-based logical row index. This is the setter
counterpart to `datagrid-get-elt'.

Cost and copying (functional default, INPLACE nil): only the single
targeted column is copied. The returned datagrid gets a fresh
`columns' vector -- a shallow O(ncols) pointer copy of the spine --
in which the target column struct is replaced by a copy whose data
vector is a fresh O(nrows) copy with the one slot overwritten. Every
other column, including its data vector, is shared by reference with
DATAGRID rather than copied, and the `row-order'/`col-order'
permutations are shared as well. Total work is therefore
O(nrows + ncols), not a full O(nrows * ncols) grid copy, and DATAGRID
itself is never modified.

When INPLACE is non-nil the targeted slot is overwritten directly in
DATAGRID's existing column data vector, and DATAGRID is returned
unchanged in identity -- no copying occurs (O(1)). This escapes the
functional model: datagrid shares column data vectors across grids
derived by `datagrid-sort', `datagrid-filter-by-mask',
`datagrid-slice', `datagrid-select', and friends (see `datagrid' for
the sharing contract), so an in-place write is visible in every grid
that shares the mutated vector. Only pass INPLACE when DATAGRID's
target column is known not to be shared."
  (datagrid--check datagrid)
  (let* ((j (datagrid--col-at datagrid
                              (datagrid--resolve-col datagrid column-num)))
         (phys-row (datagrid--row-at datagrid row-num)))
    (if inplace
        (progn
          (aset (datagrid-column-data (aref (datagrid-columns datagrid) j))
                phys-row value)
          datagrid)
      (let* ((new-cols (copy-sequence (datagrid-columns datagrid)))
             (new-col (datagrid-column-copy (aref new-cols j)))
             (new-data (copy-sequence (datagrid-column-data new-col))))
        (aset new-data phys-row value)
        (setf (datagrid-column-data new-col) new-data)
        (setf (aref new-cols j) new-col)
        (datagrid-make :columns new-cols
                       :row-order (datagrid-row-order datagrid)
                       :col-order (datagrid-col-order datagrid))))))

(defun datagrid--resolve-col (datagrid spec)
  "Resolve a logical column index in DATAGRID from SPEC.
SPEC is an integer index or a heading string."
  (cond ((integerp spec) spec)
        ((stringp spec)
         (or (datagrid-col-index-by-heading datagrid spec)
             (error "No column with heading %S in datagrid" spec)))
        (t (error "Bad column spec: %S" spec))))

(defun datagrid-pull (datagrid col)
  "Return the data vector in logical column order.
COL is a zero-based logical index or a heading string. If
DATAGRID has a row-order, returns a freshly built vector in
logical order; otherwise returns the underlying data
vector."
  (let* ((cols (datagrid-columns datagrid))
         (j (datagrid--col-at datagrid (datagrid--resolve-col datagrid col)))
         (data (datagrid-column-data (aref cols j)))
         (order (datagrid-row-order datagrid)))
    (if order
        (vconcat (cl-loop for i across order collect (aref data i)))
      data)))

(defun datagrid--materialize-columns (datagrid &optional transform ncount)
  "Return a vector of DATAGRID's columns materialized in logical order.
Each element is a fresh copy of the corresponding logical column whose
data slot holds the logically-ordered vector from `datagrid-pull', so
the result carries no row-order or col-order. NCOUNT limits how many
leading logical columns to materialize (default all). TRANSFORM, when
non-nil, is called as (funcall TRANSFORM J DATA) with the logical index
J and that column's pulled data, and its result replaces the data slot."
  (let ((n (or ncount (datagrid--ncols datagrid)))
        (cols (datagrid-columns datagrid)))
    (vconcat
     (cl-loop for j from 0 below n
              for new = (datagrid-column-copy
                         (aref cols (datagrid--col-at datagrid j)))
              for data = (datagrid-pull datagrid j)
              do (setf (datagrid-column-data new)
                       (if transform (funcall transform j data) data))
              collect new))))

(defun datagrid-get-col-data (datagrid index)
  "Extract a column vector from DATAGRID at logical INDEX.
Deprecated. Use `datagrid-pull' instead."
  (declare (obsolete datagrid-pull "1.1"))
  (datagrid-pull datagrid index))

(defun datagrid-get-row-data (datagrid row-num)
  "Extract logical row ROW-NUM from DATAGRID as a fresh vector."
  (let* ((cols (datagrid-columns datagrid))
         (ncols (datagrid--ncols datagrid))
         (phys-row (datagrid--row-at datagrid row-num)))
    (vconcat (cl-loop for j from 0 below ncols
                      for phys-col = (datagrid--col-at datagrid j)
                      collect (aref (datagrid-column-data (aref cols phys-col))
                                    phys-row)))))

(defun datagrid-get-headings (datagrid)
  "Create a vector of all DATAGRID headings in logical column order."
  (let ((cols (datagrid-columns datagrid))
        (ncols (datagrid--ncols datagrid)))
    (vconcat (cl-loop for j from 0 below ncols
                      collect (datagrid-column-heading
                               (aref cols (datagrid--col-at datagrid j)))))))

(defvar datagrid-print-head-rows 5
  "Number of leading logical rows shown when a datagrid is printed.
Used by `cl-print-object' and `datagrid-describe'. The summary line is
always printed; up to this many rows of data follow, with a count of
any remaining rows.")

(defun datagrid--format-summary (datagrid)
  "Return the one-line summary string for DATAGRID's logical view.
Reports logical dimensions and headings, not the physical `columns'
vector."
  (let ((ncols (datagrid--ncols datagrid))
        (nrows (datagrid--nrows datagrid)))
    (format "#<datagrid %d %s x %d %s%s>"
            ncols (if (= ncols 1) "col" "cols")
            nrows (if (= nrows 1) "row" "rows")
            (if (zerop ncols)
                ""
              (format " | cols: [%s]"
                      (mapconcat (lambda (h) (format "%S" h))
                                 (datagrid-get-headings datagrid)
                                 " "))))))

(defun datagrid--format-head (datagrid stream)
  "Print up to `datagrid-print-head-rows' logical rows of DATAGRID to STREAM.
Rows and columns follow the logical order, so a projection from
`datagrid-select' shows only its selected columns. Does nothing when
DATAGRID is empty."
  (let ((ncols (datagrid--ncols datagrid))
        (nrows (datagrid--nrows datagrid)))
    (unless (or (zerop ncols) (zerop nrows))
      (let* ((shown (min nrows datagrid-print-head-rows))
             (headings (append (datagrid-get-headings datagrid) nil))
             (rows (cl-loop for r from 0 below shown
                            collect (cl-loop for c from 0 below ncols
                                             collect (format "%s" (datagrid-get-elt datagrid c r)))))
             (widths (cl-loop for c from 0 below ncols
                              collect (cl-loop for row in (cons headings rows)
                                               maximize (length (nth c row))))))
        (cl-flet ((emit (cells)
                    (princ "\n  " stream)
                    (princ (string-join
                            (cl-loop for c from 0 below ncols
                                     collect (string-pad (nth c cells) (nth c widths)))
                            "  ")
                           stream)))
          (emit headings)
          (princ "\n  " stream)
          (princ (mapconcat (lambda (w) (make-string w ?-)) widths "  ") stream)
          (mapc #'emit rows))
        (when (> nrows shown)
          (princ (format "\n  ... (%d more)" (- nrows shown)) stream))))))

(cl-defmethod cl-print-object ((datagrid datagrid) stream)
  "Print DATAGRID to STREAM as its logical view rather than the raw struct.
A datagrid built by `datagrid-select', `datagrid-slice', and friends
shares the source's full `columns' vector and records only a
`col-order'/`row-order' permutation, so the default struct printer
shows every physical column even when the logical grid has fewer. This
method prints the logical dimensions, headings, and the first
`datagrid-print-head-rows' rows instead, so evaluation, edebug, and the
debugger reflect what the datagrid verbs actually operate on. On any
error it falls back to the default struct printing."
  (condition-case nil
      (progn
        (princ (datagrid--format-summary datagrid) stream)
        (datagrid--format-head datagrid stream))
    (error (cl-call-next-method))))

(defun datagrid-describe (datagrid)
  "Print DATAGRID's logical view (summary plus a head) and return DATAGRID.
An explicit counterpart to the `cl-print-object' method, for
printers that bypass `cl-prin1' (such as `eval-print-last-sexp').
With no other output in play it prints to the echo area."
  (princ (datagrid--format-summary datagrid))
  (datagrid--format-head datagrid standard-output)
  datagrid)

(defun datagrid-col-index-by-heading (datagrid heading)
  "Return the logical column index in DATAGRID with HEADING.
Headings are compared with `equal'. When several columns share
HEADING, return the first. Return nil if the heading is not found."
  (cl-position heading (datagrid-get-headings datagrid) :test #'equal))

(define-obsolete-function-alias 'datagrid-col-index-by-header
  #'datagrid-col-index-by-heading "1.1")

(defun datagrid-col-data-by-header (datagrid header-text)
  "Extract column data from DATAGRID by HEADER-TEXT.
Deprecated. Use `datagrid-pull' instead."
  (declare (obsolete datagrid-pull "1.1"))
  (datagrid-pull datagrid header-text))

(defun datagrid-column-decode (datagrid col &optional default missing)
  "Return column COL of DATAGRID decoded, as a vector.
DATAGRID is the structure holding data vectors. COL is a
zero-based column number or a heading string. Decoding uses the
alist in the column's `code' slot. If the column has no code
alist, return its data unchanged.

DEFAULT is the value substituted for non-nil input values that
are not found in the coding alist (unmapped values). MISSING is
the value substituted for nil input values. Both default to nil.

Strings and symbols are matched with `string-equal'; other values,
such as numbers, are matched with `equal'.

A Likert scale column may have the following code alist.

  \\='((\"Strongly Disagree\" . 1)
    (\"Disagree\" . 2)
    (\"Neither Agree nor Disagree\" . 3)
    (\"Agree\" . 4)
    (\"Strongly Agree\" . 5))

The column data may look like the following.

  [\"Strongly Disagree\" \"Agree\" \"Disagree\"]

This function will output the following.

  [1 4 2]"
  (datagrid--check datagrid)
  (let* ((idx (datagrid--resolve-col datagrid col))
         (column (aref (datagrid-columns datagrid)
                       (datagrid--col-at datagrid idx)))
         (vec (datagrid-pull datagrid idx))
         (code (datagrid-column-code column)))
    (if (not (and code (listp code) (cl-every #'consp code)))
        vec
      ;; A key matches a value by `string-equal' when both are strings
      ;; or symbols, so "Agree" matches the symbol Agree, and by
      ;; `equal' otherwise.  Hashing with `equal' after turning symbols
      ;; into their names gives exactly those matches.  Keep the first
      ;; pair for a key, as `assoc' would find it.
      (let* ((table (make-hash-table :test #'equal :size (length code)))
             (n (length vec))
             (out (make-vector n nil)))
        (dolist (pair code)
          (let* ((key (car pair))
                 (k (if (symbolp key) (symbol-name key) key)))
            (unless (gethash k table)
              (puthash k pair table))))
        (dotimes (i n)
          (let ((x (aref vec i)))
            (aset out i
                  (if (null x)
                      missing
                    (let ((hit (gethash (if (symbolp x) (symbol-name x) x)
                                        table)))
                      (if hit (cdr hit) default))))))
        out))))

(defun datagrid--pull-decoded (datagrid col code)
  "Return DATAGRID column COL as a vector, decoded when CODE is non-nil.
With CODE non-nil the data is decoded via `datagrid-column-decode';
otherwise the raw logical vector from `datagrid-pull' is returned. COL
is a zero-based logical index or a heading string."
  (if code
      (datagrid-column-decode datagrid col)
    (datagrid-pull datagrid col)))



;;;; Slicing primitives (used by verbs and stats)
(defun datagrid--slice-rows (datagrid rows)
  "Return a datagrid restricted to logical ROWS of DATAGRID.
ROWS is a list of zero-based logical row indices. Column data is
shared with DATAGRID; only the row-order is set. Composes with any
existing row-order."
  (let* ((n (length rows))
         (new-order (make-vector n 0)))
    (cl-loop for i from 0
             for r in rows do
             (aset new-order i (datagrid--row-at datagrid r)))
    (datagrid-make :columns (datagrid-columns datagrid)
                   :row-order new-order
                   :col-order (datagrid-col-order datagrid))))

(defun datagrid--group-rows (datagrid key-indices)
  "Return the rows of DATAGRID grouped by the columns at KEY-INDICES.
KEY-INDICES is a list of zero-based logical column indices. Return a
list ((KEY . ROWS) ...) with one element per group, in first-seen
order. KEY is a list of the group's values, one per key column. ROWS
is a list of the group's logical row indices in ascending order.

Keys are compared with `equal', so nil is a key like any other value.
Return nil when DATAGRID has no rows."
  (let ((key-vecs (cl-loop for i in key-indices
                           collect (datagrid-pull datagrid i)))
        (groups (make-hash-table :test #'equal))
        (order nil))
    (dotimes (r (datagrid--nrows datagrid))
      (let ((key (cl-loop for v in key-vecs collect (aref v r))))
        (unless (gethash key groups)
          (push key order))
        (push r (gethash key groups))))
    (cl-loop for key in (nreverse order)
             collect (cons key (nreverse (gethash key groups))))))


